@model NotificationBellViewModel
<div class="dropdown">
    <button class="btn btn-light position-relative rounded-circle bell-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
        <i class="bi bi-bell"></i>
        @if (Model.UnreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount)</span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0 bell-menu">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <strong>Notifications</strong>
            <span class="small text-muted">@Model.UnreadCount unread</span>
        </div>
        @if (Model.Latest.Count == 0)
        {
            <div class="p-4 text-center text-muted small">You're all caught up.</div>
        }
        @foreach (var n in Model.Latest)
        {
            var style = Ui.Style(n.Type);
            <form asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id" method="post">
                <button type="submit" class="dropdown-item d-flex gap-2 py-2 @(n.IsRead ? "" : "unread")">
                    <span class="notif-icon sm bg-soft-@style.Tone"><i class="bi @style.Icon"></i></span>
                    <span class="text-wrap small">
                        <span class="d-block fw-semibold">@n.Message</span>
                        <span class="text-muted">@Ui.TimeAgo(n.CreatedAt)</span>
                    </span>
                </button>
            </form>
        }
        <a class="d-block text-center small py-2 border-top" asp-controller="Notifications" asp-action="Index">View all notifications</a>
    </div>
</div>
