<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body p-4 text-center">
                <div class="confirm-icon mb-3"><i class="bi bi-exclamation-lg"></i></div>
                <h5 class="fw-bold mb-2" data-confirm-title>Please confirm</h5>
                <p class="text-muted mb-4" data-confirm-message>Are you sure?</p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger px-4" data-confirm-ok>Yes, continue</button>
                </div>
            </div>
        </div>
    </div>
</div>
