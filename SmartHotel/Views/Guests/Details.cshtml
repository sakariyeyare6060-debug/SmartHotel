@model GuestDetailsViewModel
@{
    var g = Model.Guest;
    ViewData["Title"] = g.FullName;
}
<div class="page-header">
    <div>
        <div class="breadcrumb-sh"><a asp-action="Index">Guests</a> / @g.Code</div>
        <h1 class="page-title">@g.FullName</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-light"><i class="bi bi-pencil-square me-1"></i>Edit</a>
        <a asp-controller="Bookings" asp-action="Create" asp-route-guestId="@g.Id" class="btn btn-primary"><i class="bi bi-calendar-plus me-1"></i>New Booking</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-4">
        <div class="card-sh">
            <div class="card-body text-center border-bottom">
                <span class="avatar avatar-lg mb-2">@Ui.Initials(g.FullName)</span>
                <h2 class="h5 fw-bold mb-0">@g.FullName</h2>
                <div class="text-muted small">Guest since @g.CreatedAt.ToString("MMM yyyy")</div>
            </div>
            <div class="card-body">
                <dl class="dl-sh">
                    <dt>Phone</dt><dd>@g.Phone</dd>
                    <dt>Email</dt><dd>@(g.Email ?? "—")</dd>
                    <dt>@(g.IdType ?? "ID")</dt><dd>@(g.IdNumber ?? "—")</dd>
                    <dt>Nationality</dt><dd>@(g.Nationality ?? "—")</dd>
                    <dt>Date of birth</dt><dd>@Ui.Date(g.DateOfBirth)</dd>
                    <dt>Address</dt><dd>@(g.Address ?? "—")</dd>
                    @if (!string.IsNullOrEmpty(g.Notes))
                    {
                        <dt>Notes</dt><dd>@g.Notes</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="row g-3 mb-3 row-cols-1 row-cols-sm-3">
            <div class="col">@await Html.PartialAsync("_StatCard", new StatCardModel("Completed stays", Model.TotalStays.ToString(), "bi-house-check", "primary"))</div>
            <div class="col">@await Html.PartialAsync("_StatCard", new StatCardModel("Nights", Model.TotalNights.ToString(), "bi-moon-stars", "purple"))</div>
            <div class="col">@await Html.PartialAsync("_StatCard", new StatCardModel("Total paid", Ui.Money(Model.TotalSpent, true), "bi-wallet2", "green"))</div>
        </div>
        <div class="card-sh">
            <div class="card-head"><h2>Booking History</h2></div>
            <div class="table-responsive">
                <table class="table table-sh">
                    <thead><tr><th>Booking</th><th>Room</th><th>Check-in</th><th>Check-out</th><th>Nights</th><th>Amount</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var b in Model.Bookings)
                    {
                        <tr>
                            <td><a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="fw-semibold">@b.BookingNumber</a></td>
                            <td>@b.Room?.RoomNumber <span class="text-muted small">@b.Room?.RoomType?.Name</span></td>
                            <td>@Ui.Date(b.CheckInDate)</td>
                            <td>@Ui.Date(b.CheckOutDate)</td>
                            <td>@b.Nights</td>
                            <td>@Ui.Money(b.TotalAmount)</td>
                            <td>@Ui.Badge(b.Status)</td>
                        </tr>
                    }
                    @if (Model.Bookings.Count == 0)
                    {
                        <tr><td colspan="7" class="empty-state"><i class="bi bi-calendar-x"></i>No bookings yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
