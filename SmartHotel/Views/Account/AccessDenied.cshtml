@{
    ViewData["Title"] = "Access denied";
    Layout = "_AuthLayout";
}
<div class="error-page">
    <div class="error-card">
        <div class="error-code text-danger"><i class="bi bi-shield-lock"></i></div>
        <h1 class="h4 fw-bold">Access denied</h1>
        <p class="text-muted">Your role (<strong>@User.GetRole()</strong>) does not have permission to open this page.</p>
        <div class="d-flex gap-2 justify-content-center">
            <a class="btn btn-primary" href="~/">Go to my home page</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="btn btn-light">Sign in as someone else</button>
            </form>
        </div>
    </div>
</div>
