@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var frontDesk = User.IsFrontDesk();
    var management = User.IsManagement();
    var housekeeping = User.IsHousekeepingStaff();
    var maintenance = User.IsMaintenanceStaff();

    var items = new List<(string Controller, string Label, string Icon, bool Visible)>
    {
        ("Dashboard", "Dashboard", "bi-grid-1x2-fill", frontDesk),
        ("Rooms", "Rooms", "bi-door-closed", frontDesk),
        ("Bookings", "Bookings", "bi-calendar-check", frontDesk),
        ("Guests", "Guests", "bi-people", frontDesk),
        ("FrontDesk", "Check-in / Check-out", "bi-box-arrow-in-right", frontDesk),
        ("Payments", "Payments & Billing", "bi-credit-card-2-front", frontDesk),
        ("Housekeeping", "Housekeeping", "bi-stars", housekeeping),
        ("Maintenance", "Maintenance", "bi-tools", maintenance),
        ("Staff", "Staff Management", "bi-person-badge", management),
        ("Reports", "Reports", "bi-bar-chart-line", management),
        ("Notifications", "Notifications", "bi-bell", true)
    };
}
<aside class="sidebar no-print" id="sidebar">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <i class="bi bi-buildings"></i>
        <span>Smart Hotel</span>
    </a>
    <nav aria-label="Main navigation">
        @foreach (var item in items.Where(i => i.Visible))
        {
            <a class="side-link @(string.Equals(current, item.Controller, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               asp-controller="@item.Controller" asp-action="Index">
                <i class="bi @item.Icon"></i><span>@item.Label</span>
            </a>
        }
    </nav>
    <div class="sidebar-user">
        <span class="avatar">@Ui.Initials(User.GetDisplayName())</span>
        <div class="overflow-hidden">
            <div class="fw-semibold text-white text-truncate">@User.GetDisplayName()</div>
            <div class="small opacity-75">@User.GetRole()</div>
        </div>
    </div>
</aside>
