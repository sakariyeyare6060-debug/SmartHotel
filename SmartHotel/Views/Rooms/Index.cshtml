@model RoomListViewModel
@{
    ViewData["Title"] = "Room Management";
    var canManage = User.IsManagement();
}
<div class="page-header">
    <div>
        <h1 class="page-title">Room Management</h1>
        <p class="page-subtitle">Rooms, room types, prices and availability.</p>
    </div>
    @if (canManage)
    {
        <div class="d-flex gap-2">
            <a asp-action="Types" class="btn btn-light"><i class="bi bi-tags me-1"></i>Room Types</a>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Room</a>
        </div>
    }
</div>

<div class="card-sh">
    <form method="get" class="card-filter row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-icon"><i class="bi bi-search"></i>
                <input name="search" value="@Model.Search" class="form-control" placeholder="Search rooms..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="roomTypeId" class="form-select" onchange="this.form.submit()">
                <option value="">All Types</option>
                @foreach (var t in Model.RoomTypes)
                {
                    <option value="@t.Id" selected="@(Model.RoomTypeId == t.Id)">@t.Name</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Status</option>
                @foreach (var s in Enum.GetValues<RoomStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s)">@s.DisplayName()</option>
                }
            </select>
        </div>
        <div class="col-md-1 d-grid"><button class="btn btn-light" aria-label="Search"><i class="bi bi-funnel"></i></button></div>
    </form>
    @if (Model.Ready)
    {
        <div class="px-3 pb-2"><span class="pill pill-info">Ready for guests: Available + Clean <a asp-action="Index" class="ms-1" aria-label="Clear filter"><i class="bi bi-x-lg"></i></a></span></div>
    }

    <div class="table-responsive">
        <table class="table table-sh">
            <thead>
            <tr><th>Room No</th><th>Room Type</th><th>Floor</th><th>Capacity</th><th>Price / Night</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rooms.Items)
            {
                <tr>
                    <td class="fw-semibold">@r.RoomNumber</td>
                    <td>@r.RoomType?.Name</td>
                    <td>@r.Floor</td>
                    <td><i class="bi bi-person text-muted"></i> @r.RoomType?.Capacity</td>
                    <td>@Ui.Money(r.PricePerNight)</td>
                    <td>@Ui.Badge(r.Status)</td>
                    <td class="actions">
                        @if (r.IsReady)
                        {
                            <a asp-controller="Bookings" asp-action="Create" asp-route-roomId="@r.Id" class="btn-icon success" title="Book this room"><i class="bi bi-calendar-plus"></i></a>
                        }
                        @if (canManage)
                        {
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn-icon edit" title="Edit"><i class="bi bi-pencil-square"></i></a>
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" data-confirm="Delete room @r.RoomNumber? All its bookings, invoices, payments and repair records are deleted too. This cannot be undone." data-confirm-title="Delete room">
                                <button type="submit" class="btn-icon delete" title="Delete"><i class="bi bi-trash3"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Rooms.TotalCount == 0)
            {
                <tr><td colspan="7" class="empty-state"><i class="bi bi-door-closed"></i>No rooms match your filters.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Rooms" />
</div>
