@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}
<div class="page-header">
    <div>
        <div class="breadcrumb-sh"><a asp-action="Index">Staff</a> / Reset password</div>
        <h1 class="page-title">Reset password for @Model.FullName</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-6 col-xl-5">
        <div class="card-sh">
            <div class="card-body">
                <form asp-action="ResetPassword" method="post" autocomplete="off">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FullName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-primary"><i class="bi bi-key me-1"></i>Reset password</button>
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
