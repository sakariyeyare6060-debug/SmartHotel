@model RoomTypesViewModel
@{
    ViewData["Title"] = "Room Types";
    var f = Model.Form;
}
<div class="page-header">
    <div>
        <div class="breadcrumb-sh"><a asp-action="Index">Rooms</a> / Room types</div>
        <h1 class="page-title">Room Types</h1>
        <p class="page-subtitle">Categories, base prices and capacity.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card-sh">
            <div class="table-responsive">
                <table class="table table-sh">
                    <thead><tr><th>Name</th><th>Base Price</th><th>Max Guests</th><th>Rooms</th><th>Amenities</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var t in Model.Types)
                    {
                        <tr>
                            <td><div class="fw-semibold">@t.Name</div><div class="small text-muted">@t.Description</div></td>
                            <td>@Ui.Money(t.BasePrice)</td>
                            <td>@t.Capacity</td>
                            <td>@Model.RoomCounts.GetValueOrDefault(t.Id)</td>
                            <td class="small text-muted">@t.Amenities</td>
                            <td class="actions">
                                <a asp-action="Types" asp-route-editId="@t.Id" class="btn-icon edit" title="Edit"><i class="bi bi-pencil-square"></i></a>
                                <form asp-action="DeleteType" asp-route-id="@t.Id" method="post" data-confirm="Delete room type '@t.Name'? All rooms of this type, with their bookings, invoices and payments, are deleted too. This cannot be undone.">
                                    <button class="btn-icon delete" title="Delete"><i class="bi bi-trash3"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card-sh">
            <div class="card-head"><h2>@(f.Id.HasValue ? $"Edit '{f.Name}'" : "New room type")</h2></div>
            <div class="card-body">
                <form asp-action="SaveType" method="post">
                    <input type="hidden" asp-for="Form.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="mb-3">
                        <label asp-for="Form.Name" class="form-label"></label>
                        <input asp-for="Form.Name" class="form-control" />
                        <span asp-validation-for="Form.Name" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="Form.BasePrice" class="form-label"></label>
                            <input asp-for="Form.BasePrice" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Form.BasePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Form.Capacity" class="form-label"></label>
                            <input asp-for="Form.Capacity" type="number" class="form-control" />
                            <span asp-validation-for="Form.Capacity" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.Description" class="form-label"></label>
                        <input asp-for="Form.Description" class="form-control" />
                    </div>
                    <div class="mb-4">
                        <label asp-for="Form.Amenities" class="form-label"></label>
                        <input asp-for="Form.Amenities" class="form-control" placeholder="Wi-Fi, TV, Mini bar" />
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save</button>
                        @if (f.Id.HasValue)
                        {
                            <a asp-action="Types" class="btn btn-light">New instead</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
