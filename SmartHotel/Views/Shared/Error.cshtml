@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_AuthLayout";
}
<div class="error-page">
    <div class="error-card">
        <div class="error-code text-danger"><i class="bi bi-exclamation-octagon"></i></div>
        <h1 class="h4 fw-bold">Something went wrong</h1>
        <p class="text-muted">An unexpected error occurred while processing your request. The problem has been logged.</p>
        @if (!string.IsNullOrEmpty(Model?.RequestId))
        {
            <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" href="~/">Back to dashboard</a>
    </div>
</div>
